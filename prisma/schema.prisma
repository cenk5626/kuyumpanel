generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                String    @default("USER") // SUPER_ADMIN, ADMIN, USER, TABLET, PC
  permissions         String?   @default("[\"dashboard\",\"prices\",\"stocks\",\"transactions\",\"suppliers\",\"price-check\",\"users\"]")
  dealerId            String?   // Nullable for SUPER_ADMIN
  dealer              Dealer?   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  twoFactorSecret     String?   // Şifreli TOTP secret
  twoFactorEnabled    Boolean   @default(false)
  recoveryCodes       String?   // Şifreli kurtarma kodları JSON dizisi
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // Brute force koruması geçici kilit
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Dealer {
  id                   String                   @id @default(cuid())
  name                 String                   @unique
  users                User[]
  stocks               Stock[]
  transactions         Transaction[]
  transactionRevisions TransactionRevisionLog[]
  employees            Employee[]
  productItems         ProductItem[]
  categories           Category[]
  suppliers            Supplier[]
  customers            Customer[]
  auditLogs            AuditLog[]
  cashRegisterSessions CashRegisterSession[]
  cashMovements        CashMovement[]
  priceAlerts          PriceAlert[]
  stockAuditSessions   StockAuditSession[]
  invoices             Invoice[]
  installmentPlans     InstallmentPlan[]
  scrapInventories     ScrapInventory[]
  workshopJobs         WorkshopJob[]
  customerDeposits     CustomerDeposit[]
  branches             Branch[]
  inventoryTransfers   InventoryTransfer[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  fxExchanges          FxExchange[]
  cashDiscrepancyLogs  CashDiscrepancyLog[]
  customerLoyaltyLogs  CustomerLoyaltyLog[]
  customerSpecialDayLogs CustomerSpecialDayLog[]
  expenseVouchers      ExpenseVoucher[]
  serviceOrders        ServiceOrder[]
  customerSegments     CustomerSegment[]
  contactConsents      ContactConsent[]
  campaigns            Campaign[]
  quotes               Quote[]
  demandForecastSettings DemandForecastSettings?
  approvalRequests     ApprovalRequest[]
  rfidTags             RfidTag[]
  rfidStocktakeSessions RfidStocktakeSession[]
  salesChannels        SalesChannel[]
  externalOrders       ExternalOrder[]
  complianceCases      ComplianceCase[]
  amlRiskRules         AmlRiskRule[]
  customerRiskProfiles CustomerRiskProfile[]
  bankAccounts         BankAccount[]
  posTerminals         PosTerminal[]
  bankTransactions     BankTransaction[]
  posSettlements       PosSettlement[]
  priceSnapshots       PriceSnapshot[]
  milyemSnapshots      MilyemSnapshot[]
  businessBankAccounts BusinessBankAccount[]
  customerIdentities   CustomerIdentity[]
  notebookEntries      JewelerNotebookEntry[]

  // AI Patron Asistanı Ayarları (BYOK - Bring Your Own Key)
  aiProvider           String?                  @default("GEMINI") // "GEMINI" | "OPENAI"
  geminiApiKey         String?
  openaiApiKey         String?
  aiModel              String?                  @default("gemini-2.0-flash") // "gemini-2.0-flash" | "gpt-4o" | "gpt-4o-mini"
  aiSystemPromptExtra  String?

  // WhatsApp Entegrasyon Ayarları
  whatsappProvider     String?                  @default("WEB_INTENT") // "WEB_INTENT" | "CLOUD_API" | "GATEWAY"
  whatsappPhone        String?                  // Patronun bildirim alacağı GSM numarası (örn: 90532xxxxxxx)
  waCloudAccessToken   String?
  waCloudPhoneId       String?
  waCloudBusinessId    String?
  waGatewayInstanceId  String?
  waGatewayToken       String?

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

// Aktif has fiyatı — singleton upsert (id="singleton"), geçmiş tutulmaz
model HasPrice {
  id        String   @id @default("singleton")
  bid       Float
  ask       Float
  source    String   @default("altis") // "altis" | "harem"
  updatedAt DateTime @updatedAt
}

// Eski ziynet has milyemleri — kod bazlı upsert (YCEYREK, YYARIM, YTAM)
model ZiynetPrice {
  id        String   @id // YCEYREK | YYARIM | YTAM
  bid       Float
  ask       Float
  updatedAt DateTime @updatedAt
}

// Fiyat ayarları — singleton upsert (id="singleton")
model PriceSettings {
  id            String   @id @default("singleton")
  sourceOrder   String   @default("[\"altis\",\"harem\"]") // JSON dizisi
  priceOffsets  String   @default("{}") // JSON objesi (hasBid, hasAsk, usdBid, usdAsk, vb.)
  mil24Ayar     Float    @default(1000)
  mil22Ayar     Float    @default(916)
  milAdanaBurma Float    @default(931)
  milAjda       Float    @default(942)
  mil14Ayar     Float    @default(583)
  gremseMil     Float    @default(0) // Gremse milyem cinsinden
  updatedAt     DateTime @updatedAt
}

// Stok Durumu Tablosu
model Stock {
  id           String   @id @default(cuid())
  product      String   // Örn: "USD", "ECEYREKTL"
  label        String   // Ürün Adı (Örn: "Amerikan Doları", "Eski Çeyrek")
  type         String   // "sarrafiye" | "döviz"
  amount       Float    @default(0) // Güncel stok seviyesi
  minThreshold Float    @default(5) // Minimum kritik stok seviyesi
  dealerId     String
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt

  @@unique([product, dealerId])
}

// Alış/Satış İşlemleri Geçmişi
model Transaction {
  id             String                   @id @default(cuid())
  dealerId       String
  dealer         Dealer                   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  type           String                   // "buy" (Alış - biz alıyoruz, stok artar) | "sell" (Satış - biz satıyoruz, stok azalır)
  productType    String                   // "sarrafiye" | "döviz" | "hurda" | "taki"
  productCode    String                   // Örn: "USD", "ECEYREKTL", "HURDA_22K"
  quantity       Float                    // İşlem miktarı
  price          Float                    // Birim fiyat (TL)
  total          Float                    // Toplam tutar (TL)
  costPrice      Float?                   // İşlem anındaki maliyet fiyatı (TL)
  profitAmount   Float?                   // Net kâr/zarar tutarı (TL)
  profitMargin   Float?                   // Kâr marjı (%)
  isSuspicious   Boolean                  @default(false) // Şüpheli işlem bayrağı
  suspiciousReason String?                // Şüphe nedeni
  isDeleted      Boolean                  @default(false) // Mantıksal silme bayrağı
  paymentMethod  String                   @default("CASH") // "CASH" | "CARD" | "BANK" | "HAS" | "DEBT"
  cardFeePercent Float?                   // Kredi kartı komisyon oranı (%)
  hasEquivalent  Float?                   @default(0) // Has altın karşılığı (gr)
  orderNote      String?                  // Sipariş / İşlem notu
  customerId     String?                  // Müşteri ID (varsa)
  sessionId      String?                  // İlgili Kasa / Z-Raporu oturumu
  session        CashRegisterSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employeeName   String?                  // İşlemi gerçekleştiren çalışan adı
  revisions      TransactionRevisionLog[]
  createdAt      DateTime                 @default(now())
}

// İşlem Düzenleme & Silme Revizyon Günlüğü
model TransactionRevisionLog {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  dealerId      String
  dealer        Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  actionType    String      // "EDIT" | "DELETE" | "RESTORE"
  previousData  String      // JSON serialized previous transaction snapshot
  newData       String?     // JSON serialized new transaction snapshot (null on delete)
  reason        String      // Düzeltme / Silme nedeni
  userEmail     String?
  userName      String?
  createdAt     DateTime    @default(now())
}

// Gün Sonu & Kasa Kapatma (Z-Raporu) Oturum Modeli
model CashRegisterSession {
  id             String         @id @default(cuid())
  sessionNumber  String         // Örn: "Z-2026-0001"
  status         String         @default("OPEN") // "OPEN" | "CLOSED"
  openingCash    Float          @default(0)
  closingCash    Float?
  systemCash     Float          @default(0)
  countedCash    Float?
  discrepancy    Float?
  notes          String?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  openedBy       String         // Açan personel adı
  closedBy       String?        // Kapatan personel adı

  // Para birimi bazlı açılış tutarları
  openingCashTL  Float          @default(0)
  openingCashUSD Float          @default(0)
  openingCashEUR Float          @default(0)
  openingHasGram Float          @default(0)

  // Para birimi bazlı sistem hesaplanan tutarları
  systemCashTL   Float          @default(0)
  systemCashUSD  Float          @default(0)
  systemCashEUR  Float          @default(0)
  systemHasGram  Float          @default(0)
  systemCardTL   Float          @default(0)

  // Fiili sayım tutarları (Physical Cash Count)
  countedCashTL  Float?
  countedCashUSD Float?
  countedCashEUR Float?
  countedHasGram Float?

  // Mutabakat farkları (Counted - System)
  diffCashTL     Float?
  diffCashUSD    Float?
  diffCashEUR    Float?
  diffHasGram    Float?

  // FAZ 3: Çok Para Birimli Döviz & Altın Kuru Değerleme Kâr/Zararı
  openingRateUSD Float?
  closingRateUSD Float?
  openingRateEUR Float?
  closingRateEUR Float?
  openingRateHAS Float?
  closingRateHAS Float?
  forexGainLossTL Float?        @default(0) // Gün içi kur değişiminden kaynaklanan kambiyo kâr/zararı (TL)

  dealerId       String
  dealer         Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  movements      CashMovement[]
  transactions   Transaction[]
  fxExchanges    FxExchange[]
  discrepancyLogs CashDiscrepancyLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Kasa İçi Manuel ve Gün İçi Hareketler
model CashMovement {
  id            String              @id @default(cuid())
  sessionId     String
  session       CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dealerId      String
  dealer        Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  type          String              // "POS_SALE" | "CUSTOMER_COLLECTION" | "SUPPLIER_PAYMENT" | "SCRAP_BUY" | "MANUAL_IN" | "MANUAL_OUT" | "INFLOW" | "OUTFLOW"
  category      String?             // "EXPENSE" | "DRAWING" | "CAPITAL" | "CORRECTION" | "SALES" | "COLLECTION"
  paymentMethod String              @default("CASH") // "CASH" | "CARD" | "BANK" | "HAS" | "DEBT"
  amount        Float               // Hareket tutarı
  currency      String              @default("TL") // "TL" | "USD" | "EUR" | "HAS"
  hasEquivalent Float?              @default(0) // Has altın karşılığı (gr)
  description   String              // Hareket açıklaması
  referenceId   String?             // İlgili işlem referans ID
  employeeName  String?             // İşlemi yapan personel
  createdAt     DateTime            @default(now())
}

// Bayi altındaki çalışanlar (Login hesabı değildir)
model Employee {
  id        String   @id @default(cuid())
  name      String
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Nihai İşlenmiş Fiyatlar (Fark ve Marjlar Eklenmiş)
model LivePrice {
  id        String   @id // Örn: "GAUTRY", "USDTRY", "ECEYREKTL", "mil22Ayar"
  label     String   // Ürün Adı (Örn: "Has Altın", "22 Ayar Bilezik")
  bid       Float    // Nihai Alış Fiyatı (TL)
  ask       Float    // Nihai Satış Fiyatı (TL)
  updatedAt DateTime @updatedAt
}

// Tekil Takı Ürünleri (Stokta olan veya satılmış)
model ProductItem {
  id           String   @id @default(cuid())
  barcode      String   @unique // Örn: 14KP00001
  title        String   @default("") // Ürün Adı (Seçilen kategori ismiyle fallback)
  description  String?  // Ürün Açıklaması
  quantity     Int      @default(1) // Adet
  category     String?  // Kategori Adı (Örn: Küpe)
  subType      String?  // Alt Tür Adı (Örn: Ajda)
  subSubType   String?  // Alt Alt Tür Adı (Örn: Oluklu)
  carat        Int      // Ayar (24, 22, 18, 14, 8 vb.)
  weight       Float    // Birim Ağırlığı (gr)
  size         String?  // Beden / Ölçü
  costMilyem   Float    // Geliş Milyemi (örn: 0.585)
  laborMilyem  Float    // Giriş İşçiliği (örn: 0.120)
  sellingMilyem Float?   // Satış Milyemi (örn: 0.931 veya 0.705)
  profitMargin Float    // Yüzdelik Kar Oranı (örn: 10)
  costPrice    Float?   // Maliyet Fiyatı (TL)
  laborType    String   @default("milyem")
  laborCost    Float    @default(0)
  status       String   @default("IN_STOCK") // "IN_STOCK" | "SOLD" | "RETURNED"
  supplierName String?  // Toptancı Adı
  
  // Pırlanta & Değerli Taş (4C) Özellikleri
  isDiamond         Boolean  @default(false)
  diamondCarat      Float?   // Karat (ct - örn: 0.35)
  diamondColor      String?  // Renk (D, E, F, G, H, I, J, K...)
  diamondClarity    String?  // Berraklık (FL, IF, VVS1, VVS2, VS1, VS2, SI1, SI2, I1)
  diamondCut        String?  // Kesim (Excellent, Very Good, Good, Fair)
  certificateNo     String?  // Sertifika No (GIA-123456, HRD-98765 vb.)
  certificateOrg    String?  // GIA, HRD, IGI, MAĞAZA
  diamondStoneCount Int?     @default(1) // Taş Adedi
  
  dealerId          String
  dealer            Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transferLines     InventoryTransferLine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Category {
  id            String        @id @default(cuid())
  name          String
  code          String        // Kısaltma (örn: KP, BLZ, YZK, KLY)
  dealerId      String
  dealer        Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id             String           @id @default(cuid())
  name           String
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subSubCategories SubSubCategory[]
  createdAt      DateTime         @default(now())
}

model SubSubCategory {
  id            String      @id @default(cuid())
  name          String
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Supplier {
  id           String                @id @default(cuid())
  name         String
  phone        String?
  address      String?
  note         String?
  hasBalance   Float                 @default(0) // Has Altın Bakiyesi (gr Has) - Pozitif: Toptancıya Has borcumuz var
  tlBalance    Float                 @default(0) // TL Bakiyesi (₺) - Pozitif: Toptancıya TL borcumuz var
  dealerId     String
  dealer       Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  transactions SupplierTransaction[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  notebookEntries JewelerNotebookEntry[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt @default(now())
}

model SupplierTransaction {
  id                 String   @id @default(cuid())
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  dealerId           String
  type               String   // "PURCHASE" | "HAS_PAYMENT" | "TL_PAYMENT" | "SETTLEMENT" | "VIRMAN_OUT" | "VIRMAN_IN"
  hasAmount          Float    @default(0) // Has Altın Tutarı (gr Has)
  tlAmount           Float    @default(0) // TL Tutarı (₺)
  unitPrice          Float?   // İşlem anındaki Has altın fiyatı (TL/gr)
  targetSupplierId   String?  // Virman yapılan hedef toptancı ID
  targetSupplierName String?  // Virman yapılan hedef toptancı Adı
  documentNo         String?  // Belge / İrsaliye / Fatura No
  description        String?  // İşlem açıklaması
  employeeName       String?  // İşlemi yapan personel
  createdAt          DateTime @default(now())
}

// Sistem & İşlem Logları (Audit Log - Append Only)
model AuditLog {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  action    String   // Örn: "POS Satış", "Stok Düzeltme", "Müşteri Borç Ekleme", "Şüpheli İşlem"
  details   String   // Detaylı işlem açıklaması
  userId    String?  // İşlemi yapan kullanıcı ID'si
  userEmail String?  // İşlemi yapan kullanıcı e-postası
  userName  String?  // İşlemi yapan kullanıcı adı
  ipAddress String?  // İstekçi IP adresi
  userAgent String?  // İstekçi tarayıcı bilgisi
  oldValues String?  // JSON: Değişiklik öncesi durum
  newValues String?  // JSON: Değişiklik sonrası durum
  reason    String?  // Düzeltme / Değişiklik gerekçesi
  createdAt DateTime @default(now())
}

// Müşteri Rehberi
model Customer {
  id             String                @id @default(cuid())
  name           String
  phone          String?
  email          String?
  tcNo           String?
  address        String?
  note           String?
  hasBalance     Float                 @default(0) // gr Has cinsinden borç (+) veya alacak (-) bakiyesi
  tlBalance      Float                 @default(0) // TL cinsinden borç (+) veya alacak (-) bakiyesi
  creditLimitTL  Float?                @default(0) // Tanımlanan maksimum TL borçlanma limiti (0 = limitsiz)
  creditLimitHas Float?                @default(0) // Tanımlanan maksimum Has Altın borçlanma limiti (gr)
  loyaltyPoints  Float                 @default(0) // Müşteri ParaPuan / Sadakat Puanı
  loyaltyTier    String?               @default("BRONZE") // "BRONZE" | "SILVER" | "GOLD" | "PLATINUM"
  emanetGold     Float                 @default(0) // Emanet Altın Kasası toplam (gr Has)
  birthDate      DateTime?             // Doğum Günü
  anniversaryDate DateTime?            // Evlilik Yıldönümü / Özel Gün
  rfmSegment     String?               // "CHAMPION" | "LOYAL" | "POTENTIAL_LOYALIST" | "AT_RISK" | "HIBERNATING" | "LOST" | "NEW"
  rfmScore       Int?                  // 111 - 555
  rfmRecencyDays Int?                  // Son alışverişten bu yana geçen gün sayısı
  rfmFrequency   Int?                  // Toplam alışveriş / işlem adedi
  rfmMonetaryTL  Float?                // Toplam ciro / harcama tutarı TL
  dealerId       String
  dealer         Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  transactions CustomerTransaction[]
  installmentPlans InstallmentPlan[]
  invoices       Invoice[]
  deposits       CustomerDeposit[]
  loyaltyLogs    CustomerLoyaltyLog[]
  specialDayLogs CustomerSpecialDayLog[]
  serviceOrders  ServiceOrder[]
  contactConsents ContactConsent[]
  campaignRecipients CampaignRecipient[]
  quotes         Quote[]
  riskProfile    CustomerRiskProfile?
  complianceCases ComplianceCase[]
  customerIdentities CustomerIdentity[]
  notebookEntries JewelerNotebookEntry[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt @default(now())
}

// Müşteri Borç / Alacak (Veresiye) İşlem Hareketleri
model CustomerTransaction {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealerId      String
  type          String   // "BORC" (Müşteriye Borç Verme - Alacağımız Artar) | "TAHSILAT" (Müşteriden Alacak/Tahsilat Alımı)
  assetType     String   // "TL" | "USD" | "EUR" | "HAS" | "CEYREK" | "22K" | "14K" vb.
  amount        Float    // İşlenen öz tutar (örn: 10000 TL, 500 USD, 2 Adet, 25.5 gr)
  hasEquivalent Float    @default(0) // İşlem anındaki / hesaplanan Has Altın karşılığı (gr Has)
  unitPrice     Float?   // İşlem anındaki Has altın fiyatı veya döviz kuru
  description   String?  // İşlem açıklaması / Not
  employeeName  String?  // İşlemi yapan personel
  createdAt     DateTime @default(now())
}

// Mağaza / Kuyumcu Fiyat Alarmı Modeli
model PriceAlert {
  id           String    @id @default(cuid())
  dealerId     String
  dealer       Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  productCode  String    // "HAS", "GAUTRY", "ECEYREKTL", "USDTRY", "EURTRY", "mil22Ayar"
  productLabel String    // "Has Altın (Bozma/Alış)", "USD/TRY Satış"
  targetPrice  Float     // Hedef tetiklenme fiyatı (TL)
  priceType    String    @default("bid") // "bid" (Bozma / Alış) | "ask" (Satış)
  condition    String    @default("GTE") // "GTE" (>= Eşit veya Üstü) | "LTE" (<= Eşit veya Altı)
  phone        String?   // WhatsApp bildirim gönderilecek yetkili numarası
  isActive     Boolean   @default(true)
  isTriggered  Boolean   @default(false)
  triggeredAt  DateTime?
  lastCheckedPrice Float?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Hızlı Vitrin & Tepsi Sayım Oturumu
model StockAuditSession {
  id              String    @id @default(cuid())
  sessionNumber   String    // Örn: "SAYIM-2026-0001"
  dealerId        String
  dealer          Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  scope           String    @default("ALL") // "ALL" (Tüm Vitrin) | "CATEGORY" (Kategori Bazlı)
  categoryFilter  String?   // Kategori adı (örn: "Küpe", "Yüzük")
  status          String    @default("COMPLETED") // "IN_PROGRESS" | "COMPLETED"
  totalExpected   Int       @default(0) // Sistemde olması gereken adet
  totalCounted    Int       @default(0) // Fiilen sayılan adet
  totalMissing    Int       @default(0) // Eksik / Bulunamayan adet
  totalSurplus    Int       @default(0) // Fazla / Sistemde kayıtlı olmayan adet
  expectedWeight  Float     @default(0) // Beklenen toplam gramaj
  countedWeight   Float     @default(0) // Sayılan toplam gramaj
  weightDiff      Float     @default(0) // Gram farkı
  scannedBarcodes String    @default("[]") // JSON string array
  missingItems    String    @default("[]") // JSON string array of missing objects
  auditedBy       String    // Sayımı yapan personel
  notes           String?
  createdAt       DateTime  @default(now())
}

// 3065 Sayılı KDV Kanunu 23/e Özel Matrahlı Kuyumcu Faturası & e-Arşiv
model Invoice {
  id                  String   @id @default(cuid())
  invoiceNumber       String   // Örn: "KYM202600000001"
  dealerId            String
  dealer              Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type                String   @default("OZEL_MATRAH") // OZEL_MATRAH, STANDART, IADE
  documentType        String   @default("E_ARSIV")     // E_ARSIV, E_FATURA, BILGI_FISI
  status              String   @default("ISSUED")      // ISSUED, CANCELLED, DRAFT
  customerName        String
  customerTaxId       String?  // TCKN / VKN
  customerTaxOffice   String?
  customerAddress     String?
  itemsJson           String   // JSON: [{ name, weight, carat, milyem, goldCost, laborCost, kdvPercent, kdvAmount, total }]
  totalPureGoldWeight Float    @default(0) // Toplam Has Altın Gramajı (gr)
  totalGoldAmount     Float    @default(0) // Külçe Altın Bedeli (KDV İstisnası) (TL)
  totalLaborAmount    Float    @default(0) // İşçilik Bedeli (KDV Matrahı) (TL)
  totalKdvAmount      Float    @default(0) // %20 KDV Tutarı (TL)
  grandTotal          Float    @default(0) // Genel Toplam (TL)
  note                String?  // KDV 23/e Özel Matrah Meşruat Şerhi
  issueDate           DateTime @default(now())

  // FAZ 4: e-Belge Entegratör ve Resmî Yaşam Döngüsü Alanları
  provider            String?  @default("GIB_PORTAL") // "GIB_PORTAL" | "MOCK_SANDBOX" | "ENTEGRATOR"
  environment         String?  @default("TEST") // "TEST" | "PRODUCTION"
  externalDocumentId  String?
  uuid                String?
  submissionStatus    String   @default("READY") // "DRAFT" | "READY" | "SUBMITTING" | "SENT" | "ACCEPTED" | "REJECTED" | "CANCELLED" | "ERROR"
  errorMessage        String?
  submittedAt         DateTime?
  cancelledAt         DateTime?
  pdfUrl              String?
  xmlUrl              String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Taksitli Satış & Senet Takip Ana Planı
model InstallmentPlan {
  id               String            @id @default(cuid())
  planNumber       String            // Örn: "TKST-2026-0001"
  dealerId         String
  dealer           Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalAmount      Float             // Toplam Satış Tutarı (TL)
  downPayment      Float             @default(0) // Peşinat (TL)
  remainingAmount  Float             // Kalan Taksitlendirilen Tutar (TL)
  installmentCount Int               // Taksit Sayısı
  status           String            @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  notes            String?
  items            InstallmentItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Taksit Kalemi & Matbu Senet (Bono)
model InstallmentItem {
  id            String          @id @default(cuid())
  planId        String
  plan          InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNo Int             // 1, 2, 3...
  dueDate       DateTime        // Vade Tarihi
  amount        Float           // Taksit Tutarı (TL)
  paidAmount    Float           @default(0) // Ödenen Tutar (TL)
  status        String          @default("PENDING") // PENDING, PAID, OVERDUE
  paidDate      DateTime?
  paymentMethod String?         // CASH, CARD, BANK, HAS
  senetNo       String?         // Matbu Senet Numarası (örn: SNT-2026-0001-1)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Hurda Sandığı (Farklı Ayarlardaki Hurda Altınlar)
model ScrapInventory {
  id         String   @id @default(cuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  carat      Int      // 8, 14, 18, 21, 22, 24
  weight     Float    @default(0) // Sandıktaki fiziksel hurda gramajı (gr)
  pureWeight Float    @default(0) // Has Altın Karşılığı (gr)
  notes      String?
  expenseVouchers ExpenseVoucher[]
  updatedAt  DateTime @updatedAt

  @@unique([dealerId, carat])
}

// Atölye İş Emirleri, Takoz & Ramat (Fire) Takibi
model WorkshopJob {
  id                     String    @id @default(cuid())
  jobNo                  String    // Örn: "ATL-2026-0001"
  dealerId               String
  dealer                 Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  workshopName           String    // Atölye / Taş / Dökümcü Firma Adı
  description            String    // İş Tanımı (Örn: "14K Baget Yüzük Üretimi")
  status                 String    @default("PENDING") // PENDING, IN_PRODUCTION, COMPLETED, CANCELLED
  givenWeight            Float     @default(0) // Atölyeye verilen toplam hurda/has gram (gr)
  givenPureWeight        Float     @default(0) // Verilen Has Altın Karşılığı (gr)
  givenCaratBreakdown    String?   // JSON dizi
  givenTargetMilyem      Float?    // Eritme pota milyemi
  receivedFinishedWeight Float     @default(0) // Teslim alınan mamul takı (gr)
  receivedScrapWeight    Float     @default(0) // Teslim alınan astar / fire dönüşü (gr)
  receivedTotalWeight    Float     @default(0) // Mamul + Astar (gr)
  lossWeight             Float     @default(0) // Ramat / Fire (gr)
  lossPercent            Float     @default(0) // Fire oranı (%)
  targetLossPercent      Float     @default(3.0) // İzin verilen azami fire (%)
  isExcessiveLoss        Boolean   @default(false) // Fire limiti aşıldı mı?
  laborCost              Float     @default(0) // Atölye işçilik tutarı (TL)
  laborPaymentMethod     String?   // TL, HAS
  deliveryDate           DateTime? // Termin Tarihi
  completedDate          DateTime? // Kapatılma Tarihi
  notes                  String?
  serviceOrders          ServiceOrder[]
  notebookEntries        JewelerNotebookEntry[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Emanet Altın Kasası (Cetasoft Karşılaştırmalı Özellik - Müşteri Emanet Takibi)
model CustomerDeposit {
  id              String   @id @default(cuid())
  dealerId        String
  dealer          Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            String   // "DEPOSIT" (Emanet Girişi) | "WITHDRAW" (Emanet İadesi)
  itemDescription String   // Örn: "3 Adet Burma Bilezik (22K)" veya "10 gr Has Altın"
  weight          Float    // Gramaj
  carat           Int?     // Ayar
  pureGoldWeight  Float    // Has Karşılığı (gr)
  status          String   @default("ACTIVE") // ACTIVE, RETURNED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// FAZ 1: Şube Yönetimi Modeli
model Branch {
  id                   String                @id @default(cuid())
  dealerId             String
  dealer               Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name                 String                // Örn: "Merkez Şube", "Kadıköy Şubesi", "Nişantaşı Butik"
  code                 String                // Örn: "MRKZ", "KDKY", "NST"
  address              String?
  phone                String?
  isActive             Boolean               @default(true)
  isDefault            Boolean               @default(false)
  
  users                User[]
  stocks               Stock[]
  productItems         ProductItem[]
  transactions         Transaction[]
  cashSessions         CashRegisterSession[]
  employees            Employee[]
  transfersFrom        InventoryTransfer[]   @relation("TransfersFromBranch")
  transfersTo          InventoryTransfer[]   @relation("TransfersToBranch")
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  fxExchanges          FxExchange[]
  cashDiscrepancyLogs  CashDiscrepancyLog[]
  expenseVouchers      ExpenseVoucher[]
  serviceOrders        ServiceOrder[]
  quotes               Quote[]
  businessBankAccounts BusinessBankAccount[]
  notebookEntries      JewelerNotebookEntry[]
  
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([dealerId, code])
}

// Şubeler Arası Stok / Ürün Transfer Modeli
model InventoryTransfer {
  id                String                  @id @default(cuid())
  dealerId          String
  dealer            Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  transferNumber    String                  // Örn: "TRF-2026-0001"
  fromBranchId      String
  fromBranch        Branch                  @relation("TransfersFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranchId        String
  toBranch          Branch                  @relation("TransfersToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  status            String                  @default("DRAFT") // "DRAFT" | "APPROVED" | "SHIPPED" | "RECEIVED" | "CANCELLED" | "REJECTED"
  requestedBy       String                  // İsteyen personel
  approvedBy        String?                 // Onaylayan personel
  shippedAt         DateTime?
  receivedAt        DateTime?
  notes             String?
  discrepancyNotes  String?                 // Sayım veya teslim fark notları
  lines             InventoryTransferLine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([dealerId, transferNumber])
}

// Transfer Kalemleri
model InventoryTransferLine {
  id               String            @id @default(cuid())
  transferId       String
  transfer         InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productItemId    String?           // Münferit barkodlu takı için
  productItem      ProductItem?      @relation(fields: [productItemId], references: [id], onDelete: SetNull)
  productTitle     String            // Kalem adı
  barcode          String?           // Varsa barkod
  quantity         Int               @default(1)
  weight           Float?            // Gramaj
  carat            Int?              // Ayar
  receivedQuantity Int?              // Teslim alınan adet
  notes            String?
  createdAt        DateTime          @default(now())
}

// =============================================================
// FAZ 2: Tedarik Siparişi, Mal Kabul ve Maliyet Farkı Modelleri
// =============================================================

model PurchaseOrder {
  id                   String              @id @default(cuid())
  dealerId             String
  dealer               Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderNumber          String              // Örn: "PO-2026-0001"
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               String              @default("ORDERED") // "DRAFT" | "ORDERED" | "PARTIALLY_RECEIVED" | "RECEIVED" | "CANCELLED"
  totalEstimatedWeight Float               @default(0) // Tahmini toplam gramaj
  totalEstimatedHas    Float               @default(0) // Tahmini Has karşılığı
  totalEstimatedTl     Float               @default(0) // Tahmini TL bedeli / işçilik
  notes                String?
  createdBy            String?
  approvedBy           String?
  sentAt               DateTime?
  receivedAt           DateTime?
  cancelledAt          DateTime?
  lines                PurchaseOrderLine[]
  receipts             GoodsReceipt[]
  messages             PurchaseOrderMessage[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([dealerId, orderNumber])
}

model PurchaseOrderLine {
  id                   String              @id @default(cuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productCategory      String              // "BILEZIK" | "YUZUK" | "KOLYE" | "ZIYNET" | "HAS_KULCE" vb.
  description          String
  carat                Int                 // 8, 14, 18, 22, 24
  orderedWeight        Float               // Sipariş edilen tahmini gram
  orderedQuantity      Int                 @default(1)
  laborCostPerGram     Float               @default(0) // Gr başına işçilik bedeli
  laborCurrency        String              @default("TL") // "TL" | "USD" | "EUR" | "HAS"
  receivedWeight       Float               @default(0) // Fiili mal kabulde gelen toplam gram
  receivedQuantity     Int                 @default(0) // Teslim alınan adet
  status               String              @default("PENDING") // "PENDING" | "PARTIALLY_RECEIVED" | "COMPLETED" | "CANCELLED"
  notes                String?
  goodsReceiptLines    GoodsReceiptLine[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model GoodsReceipt {
  id                   String              @id @default(cuid())
  dealerId             String
  dealer               Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderId      String?
  purchaseOrder        PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  branchId             String?
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  receiptNumber        String              // Örn: "GR-2026-0001"
  receiptDate          DateTime            @default(now())
  invoiceNumber        String?             // Toptancının fatura / irsaliye no
  receivedBy           String              // Teslim alan personel
  totalActualWeight    Float               @default(0) // Terazi ile ölçülen fiili toplam gram
  totalHasEquivalent   Float               @default(0) // Milyem hesaplı toplam saf Has gramajı
  totalLaborCostTl     Float               @default(0) // Toplam işçilik TL bedeli
  notes                String?
  lines                GoodsReceiptLine[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([dealerId, receiptNumber])
}

model GoodsReceiptLine {
  id                   String              @id @default(cuid())
  goodsReceiptId       String
  goodsReceipt         GoodsReceipt        @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId  String?
  purchaseOrderLine    PurchaseOrderLine?  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  description          String
  barcode              String?
  carat                Int
  milyem               Float               // Ayarın milyem değeri (örn: 14K -> 585, 22K -> 916 vb.)
  actualWeight         Float               // Terazi fiili gramajı
  quantity             Int                 @default(1)
  laborCostPerGram     Float               @default(0)
  laborCostTl          Float               @default(0)
  hasEquivalent        Float               // actualWeight * (milyem / 1000)
  weightVariance       Float?              // Siparişe göre gramaj farkı (actualWeight - orderedWeight)
  costVarianceNote     String?             // Fark açıklaması
  createdAt            DateTime            @default(now())
}

// =============================================================
// FAZ 3: Çok Para Birimli Kasa & Döviz Alım-Satım / Bozma Modelleri
// =============================================================

model FxExchange {
  id               String               @id @default(cuid())
  dealerId         String
  dealer           Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessionId        String?
  session          CashRegisterSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  exchangeNumber   String               // Örn: "FX-2026-0001"
  fromCurrency     String               // "USD" | "EUR" | "TL" | "HAS"
  fromAmount       Float
  toCurrency       String               // "TL" | "USD" | "EUR" | "HAS"
  toAmount         Float
  exchangeRate     Float                // Müşteriye uygulanan işlem kuru
  marketRate       Float?               // İşlem anındaki piyasa gösterge kuru
  profitTL         Float                @default(0) // Net kambiyo / arbitraj kârı (TL)
  customerName     String?              // Müşteri adı
  customerPhone    String?
  notes            String?
  createdBy        String?
  createdAt        DateTime             @default(now())

  @@unique([dealerId, exchangeNumber])
}

model CashDiscrepancyLog {
  id               String               @id @default(cuid())
  dealerId         String
  dealer           Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessionId        String
  session          CashRegisterSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currency         String               // "TL" | "USD" | "EUR" | "HAS"
  systemAmount     Float
  countedAmount    Float
  diffAmount       Float                // countedAmount - systemAmount (Pozitif: Kasa Fazlası, Negatif: Kasa Noksanı)
  status           String               @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "RESOLVED"
  explanation      String?              // Kasa sayım farkı izahatı
  reviewedBy       String?
  approvedBy       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// FAZ 4: Müşteri Sadakat & ParaPuan Hareket Kaydı
model CustomerLoyaltyLog {
  id            String    @id @default(cuid())
  dealerId      String
  dealer        Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actionType    String    // "EARN" | "REDEEM" | "ADJUST" | "EXPIRE"
  points        Float     // İşlem puanı
  tlValue       Float     // Puanın TL karşılığı
  balanceAfter  Float     // İşlem sonrası güncel puan bakiyesi
  referenceType String?   // "TRANSACTION" | "MANUAL" | "SPECIAL_DAY_GIFT"
  referenceId   String?   // İşlem ID veya özel gün ID
  description   String?   // Açıklama / Not
  createdAt     DateTime  @default(now())
}

// FAZ 4: Müşteri Özel Gün Bildirim ve Kampanya Kaydı
model CustomerSpecialDayLog {
  id             String    @id @default(cuid())
  dealerId       String
  dealer         Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  specialDayType String    // "BIRTHDAY" | "WEDDING_ANNIVERSARY" | "CUSTOM"
  channel        String    @default("WHATSAPP") // "WHATSAPP" | "SMS"
  messageText    String    // Gönderilen / hazırlanan mesaj metni
  giftPoints     Float?    // Tanımlanan hediye puan
  discountCode   String?   // İndirim kupon kodu
  status         String    @default("SENT") // "SENT" | "PENDING"
  sentAt         DateTime  @default(now())
}

// =============================================================
// FAZ 4: Resmî Gider Pusulası (Kıymetli Maden & Hurda Alım Belgesi)
// =============================================================

model ExpenseVoucher {
  id                String                @id @default(cuid())
  dealerId          String
  dealer            Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  voucherNumber     String                // Örn: "GP-2026-0001"
  issueDate         DateTime              @default(now())
  sellerName        String                // Müşteri / Bireysel Satıcı Adı
  sellerTaxId       String                // TCKN
  sellerPhone       String?
  sellerAddress     String?
  paymentMethod     String                @default("NAKIT") // "NAKIT" | "BANKA_HAVALE" | "HAS_TAKAS"
  grossAmount       Float                 // Brüt tutar (TL)
  withholdingRate   Float                 @default(0) // Stopaj oranı (örn: %0 veya %2)
  withholdingAmount Float                 @default(0) // Stopaj kesintisi (TL)
  netAmount         Float                 // Ödenen net tutar (TL)
  hasEquivalent     Float                 @default(0) // Has altın karşılığı (gram)
  status            String                @default("APPROVED") // "DRAFT" | "APPROVED" | "CANCELLED"
  signatureStatus   String                @default("SIGNED_MANUAL") // "PENDING" | "SIGNED_MANUAL" | "SIGNED_DIGITAL"
  notes             String?
  scrapInventoryId  String?               // Hurda sandığı ilişkisi
  scrapInventory    ScrapInventory?       @relation(fields: [scrapInventoryId], references: [id], onDelete: SetNull)
  lines             ExpenseVoucherLine[]
  events            ExpenseVoucherEvent[]
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([dealerId, voucherNumber])
}

model ExpenseVoucherLine {
  id                String         @id @default(cuid())
  voucherId         String
  voucher           ExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  description       String         // Kalem tanımı (örn: "22 Ayar Hurda Bilezik")
  carat             Int            // Ayar (örn: 22)
  milyem            Float          // 916
  weight            Float          // Gramaj
  unitPrice         Float          // Gram alış fiyatı
  totalPrice        Float          // weight * unitPrice
  hasEquivalent     Float          // weight * (milyem / 1000)
  createdAt         DateTime       @default(now())
}

model ExpenseVoucherEvent {
  id                String         @id @default(cuid())
  voucherId         String
  voucher           ExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  eventType         String         // "CREATED" | "APPROVED" | "SIGNED" | "CANCELLED"
  actorEmail        String?
  notes             String?
  createdAt         DateTime       @default(now())
}

// =============================================================
// FAZ 5: Servis, Tamir & Garanti Yönetimi
// =============================================================

model ServiceOrder {
  id                   String                 @id @default(cuid())
  dealerId             String
  dealer               Dealer                 @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceNumber        String                 // Örn: "SRV-2026-0001"
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName         String
  customerPhone        String
  itemDescription      String                 // Örn: "14K Tektaş Pırlanta Yüzük"
  barcode              String?                // Müşteri takısının varsa mevcut stok/barkod no
  carat                Int?                   // 8, 14, 18, 22, 24
  intakeWeight         Float                  // Teslim alınırken tartılan gramaj (gr)
  targetWeight         Float?                 // İşlem sonrası beklenen gramaj (gr)
  actualWeight         Float?                 // İşlem sonrası teslim edilen fiili gramaj (gr)
  issueDescription     String                 // Müşteri şikayeti / talep (örn: "Taş mıhlama, boy daraltma, cila")
  estimatedCostTl      Float                  @default(0) // Tahmini maliyet teklifi
  finalCostTl          Float                  @default(0) // Kesinleşen tahsil edilecek tutar
  isCustomerApproved   Boolean                @default(false) // Müşteri onay verdi mi?
  customerApprovalDate DateTime?
  workshopJobId        String?                // Atölye iş emri bağı
  workshopJob          WorkshopJob?           @relation(fields: [workshopJobId], references: [id], onDelete: SetNull)
  status               String                 @default("RECEIVED") // "RECEIVED" | "QUOTED" | "APPROVED" | "IN_WORKSHOP" | "READY" | "DELIVERED" | "CANCELLED"
  promisedDate         DateTime               // Vaat edilen teslim tarihi
  deliveredAt          DateTime?              // Fiili teslim tarihi
  warrantyMonths       Int                    @default(6) // Tamir garanti süresi (ay)
  warrantyExpiresAt    DateTime?
  technicianNotes      String?
  evidencePhotos       String?                // JSON dizisi URL'ler
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               ServiceOrderEvent[]
  photos               ServiceOrderPhoto[]
  notebookEntries      JewelerNotebookEntry[]

  @@unique([dealerId, serviceNumber])
}

model ServiceOrderEvent {
  id                   String                 @id @default(cuid())
  serviceOrderId       String
  serviceOrder         ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  fromStatus           String?
  toStatus             String
  action               String                 // "RECEIVED" | "QUOTED" | "APPROVED" | "SENT_TO_WORKSHOP" | "MARKED_READY" | "DELIVERED" | "CANCELLED"
  notes                String?
  performedBy          String?
  createdAt            DateTime               @default(now())
}

// =============================================================
// FAZ 6: CRM, Segmentasyon & İzinli WhatsApp İletişimi (ETK / KVKK)
// =============================================================

model CustomerSegment {
  id              String       @id @default(cuid())
  dealerId        String
  dealer          Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name            String       // Örn: "VIP Müşteriler", "Düğün & Çeyiz", "Has Yatırımcıları"
  type            String       @default("CUSTOM") // "VIP" | "WEDDING" | "INVESTOR" | "DORMANT" | "CUSTOM"
  description     String?
  minSpendTl      Float?       @default(0)
  maxRecencyDays  Int?
  minTransactions Int?         @default(0)
  campaigns       Campaign[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ContactConsent {
  id               String    @id @default(cuid())
  dealerId         String
  dealer           Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone            String    // İletişim numarası
  status           String    @default("OPT_IN") // "OPT_IN" | "OPT_OUT" | "PENDING"
  channel          String    @default("IN_STORE_FORM") // "IN_STORE_FORM" | "SMS_OTP" | "VERBAL_PHONE" | "DIGITAL_SIGNATURE"
  consentDate      DateTime  @default(now())
  revokedAt        DateTime?
  ipAddress        String?
  documentProofUrl String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([dealerId, customerId, phone])
}

model Campaign {
  id              String              @id @default(cuid())
  dealerId        String
  dealer          Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  title           String              // Örn: "8 Mart Dünya Kadınlar Günü %15 Pırlanta İndirimi"
  type            String              @default("DISCOUNT_COUPON") // "DISCOUNT_COUPON" | "SPECIAL_DAY_GREETING" | "NEW_COLLECTION" | "GOLD_PRICE_ALERT" | "LOYALTY_POINTS_REMINDER"
  status          String              @default("DRAFT") // "DRAFT" | "SCHEDULED" | "ACTIVE" | "COMPLETED" | "CANCELLED"
  messageTemplate String              // Dinamik şablon: "Sayın {{ad}}, mağazamızda geçerli {{indirim}} indirim fırsatı..."
  segmentId       String?
  segment         CustomerSegment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  targetCount     Int                 @default(0)
  sentCount       Int                 @default(0)
  deliveredCount  Int                 @default(0)
  optOutCount     Int                 @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  recipients      CampaignRecipient[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CampaignRecipient {
  id                  String    @id @default(cuid())
  campaignId          String
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone               String
  personalizedMessage String
  status              String    @default("PENDING") // "PENDING" | "SENT" | "FAILED" | "OPTED_OUT"
  sentAt              DateTime?
  clickedAt           DateTime?
  errorMessage        String?
  createdAt           DateTime  @default(now())
}

// =============================================================
// FAZ 7: Gelişmiş Fiyatlandırma, Özel İskonto Limitleri ve Teklif (Quotation)
// =============================================================

model Quote {
  id                      String      @id @default(cuid())
  dealerId                String
  dealer                  Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId                String?
  branch                  Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  quoteNumber             String      // Örn: "TKL-2026-0001"
  customerId              String?
  customer                Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerPhone           String?
  status                  String      @default("DRAFT") // "DRAFT" | "PENDING_APPROVAL" | "APPROVED" | "CONVERTED" | "EXPIRED" | "REJECTED"
  validUntil              DateTime    // Teklif geçerlilik bitiş anı
  baseGoldPrice           Float       // Teklif anındaki Has altın alış/satış referans kuru
  maxGoldTolerancePercent Float       @default(1.5) // Kabul edilebilir max kur artış toleransı (%)
  subtotalTl              Float
  discountTl              Float       @default(0)
  discountPercent         Float       @default(0)
  totalTl                 Float
  totalHas                Float       @default(0)
  requiresApproval        Boolean     @default(false) // Yetki tavanı aşıldığında onay gerekir
  approvedBy              String?
  approvedAt              DateTime?
  convertedTransactionId  String?     // Satışa dönüştürüldüyse oluşan transaction ID
  convertedAt             DateTime?
  notes                   String?
  lines                   QuoteLine[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([dealerId, quoteNumber])
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  barcode       String?  // Varsa stok barkodu
  title         String   // Ürün açıklaması
  carat         Int      // Ayar (örn: 14, 22)
  weight        Float    // Gramaj
  laborCost     Float    @default(0) // Birim veya toplam işçilik
  unitPrice     Float    // Birim satış fiyatı
  totalPrice    Float    // Kalem toplam fiyatı (TL)
  hasEquivalent Float    // Kalem has altın karşılığı (gr Has)
  createdAt     DateTime @default(now())
}

// =============================================================
// FAZ 8: Yönetici Analitiği & Talep Tahmini Ayarları
// =============================================================

model DemandForecastSettings {
  id                     String   @id @default(cuid())
  dealerId               String   @unique
  dealer                 Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  safetyStockDays        Int      @default(14)
  leadTimeDays           Int      @default(7)
  analysisPeriodDays     Int      @default(90)
  deadStockThresholdDays Int      @default(180)
  targetMarginPercent    Float    @default(15.0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// =============================================================
// FAZ 9: Çok Seviyeli Onay ve Denetim Akışları (Approval Engine)
// =============================================================

model ApprovalRequest {
  id              String         @id @default(cuid())
  dealerId        String
  dealer          Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  requestType     String         // "BALANCE_WRITEOFF" | "HIGH_DISCOUNT" | "CASH_OUTFLOW" | "VIRMAN" | "SCRAP_ADJUSTMENT"
  status          String         @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  requiredLevel   Int            @default(1) // 1 = ADMIN, 2 = SUPER_ADMIN
  currentLevel    Int            @default(1)
  title           String
  description     String?
  amount          Float?         // Varsa parasal veya has büyüklük
  unit            String?        @default("TL") // "TL" | "HAS_GR" | "PERCENT"
  payload         String?        // JSON metadata
  requesterId     String
  requesterName   String
  requesterEmail  String
  rejectionReason String?
  resolvedAt      DateTime?
  steps           ApprovalStep[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ApprovalStep {
  id             String          @id @default(cuid())
  requestId      String
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepLevel      Int             // 1, 2...
  requiredRole   String          // "ADMIN" | "SUPER_ADMIN"
  status         String          @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  approverId     String?
  approverName   String?
  approverEmail  String?
  note           String?
  actionAt       DateTime?
  createdAt      DateTime        @default(now())
}

// =============================================================
// FAZ 10: RFID Destekli Vitrin ve Hızlı Sayım (RFID Stocktaking)
// =============================================================

model RfidTag {
  id           String    @id @default(cuid())
  dealerId     String
  dealer       Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  epc          String    // 96-bit EPC Hex kodu
  barcode      String    // Eşleşen ürün barkodu
  location     String?   @default("VİTRİN_1") // Bulunduğu tabla/vitrin/kasa
  status       String    @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "LOST" | "DECOMMISSIONED"
  lastReadAt   DateTime?
  lastRssi     Float?    // Sinyal gücü dBm (-80 ~ -30)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([dealerId, epc])
  @@index([dealerId, barcode])
}

model RfidStocktakeSession {
  id              String               @id @default(cuid())
  dealerId        String
  dealer          Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  sessionNumber   String               // Örn: "RFID-2026-0001"
  location        String               // "TÜMÜ" | "VİTRİN_1" | "TABLA_A" vb.
  status          String               @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  expectedCount   Int                  @default(0)
  scannedCount    Int                  @default(0)
  matchedCount    Int                  @default(0)
  missingCount    Int                  @default(0)
  surplusCount    Int                  @default(0)
  startedBy       String
  completedBy     String?
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  notes           String?
  items           RfidStocktakeItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([dealerId, sessionNumber])
}

model RfidStocktakeItem {
  id             String               @id @default(cuid())
  sessionId      String
  session        RfidStocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  epc            String
  barcode        String?
  title          String?
  carat          Int?
  weight         Float?
  expectedLocation String?
  actualLocation   String?
  matchStatus    String               @default("MISSING") // "MATCHED" | "MISSING" | "SURPLUS"
  readCount      Int                  @default(0)
  rssi           Float?
  scannedAt      DateTime?
  createdAt      DateTime             @default(now())
}

// =============================================================
// FAZ 11: E-Ticaret ve Çoklu Kanal Satış (Omnichannel Hub)
// =============================================================

model SalesChannel {
  id                 String           @id @default(cuid())
  dealerId           String
  dealer             Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name               String           // "Trendyol", "Hepsiburada", "Shopify" vb.
  channelType        String           // "TRENDYOL" | "HEPSIBURADA" | "SHOPIFY" | "WOOCOMMERCE" | "CUSTOM_WEB"
  apiKey             String?
  apiSecret          String?
  merchantId         String?
  isActive           Boolean          @default(true)
  autoPriceSync      Boolean          @default(true) // Canlı kur artışında otomatik fiyat güncelleme
  priceMarkupPercent Float            @default(0) // Pazaryeri komisyon farkı (%)
  lastSyncAt         DateTime?
  orders             ExternalOrder[]
  syncLogs           ChannelSyncLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([dealerId, name])
}

model ExternalOrder {
  id             String        @id @default(cuid())
  dealerId       String
  dealer         Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  channelId      String
  channel        SalesChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  orderNumber    String        // Örn: "TY-94827104"
  customerName   String
  customerPhone  String?
  totalAmount    Float
  status         String        @default("NEW") // "NEW" | "PROCESSING" | "SHIPPED" | "CANCELLED" | "RETURNED"
  itemsJson      String        // JSON: [{ barcode, title, quantity, price }]
  cargoCompany   String?
  trackingNumber String?
  orderedAt      DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([dealerId, orderNumber])
}

model ChannelSyncLog {
  id         String       @id @default(cuid())
  channelId  String
  channel    SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  syncType   String       // "STOCK_SYNC" | "PRICE_SYNC" | "ORDER_FETCH"
  status     String       @default("SUCCESS") // "SUCCESS" | "ERROR" | "PARTIAL"
  itemCount  Int          @default(0)
  details    String?
  createdAt  DateTime     @default(now())
}

// =============================================================
// FAZ 12: Uyum, Risk ve Şüpheli İşlem Yönetimi (MASAK / AML Compliance)
// 5549 Sayılı Kanun & Suç Gelirlerinin Aklanmasının Önlenmesi
// =============================================================

model CustomerRiskProfile {
  id               String    @id @default(cuid())
  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealerId         String
  dealer           Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  riskScore        Int       @default(10) // 0-100 arası AML risk puanı
  riskLevel        String    @default("LOW") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  isPep            Boolean   @default(false) // Siyasi Nüfuz Sahibi Kişi (PEP)
  pepDetails       String?   // PEP unvanı, görevi, ilişkisi
  occupation       String?   // Meslek
  sourceOfFunds    String?   // Fon/Gelir kaynağı (Maaş, Ticaret, Miras vb.)
  idVerified       Boolean   @default(false) // Kimlik belgesi teyit edildi mi?
  idDocumentType   String?   // "TCKN" | "PASSPORT" | "BLUE_CARD" | "TAX_NO"
  idDocumentNumber String?
  notes            String?
  lastAssessedAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dealerId, riskLevel])
}

model AmlRiskRule {
  id              String   @id @default(cuid())
  dealerId        String
  dealer          Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  ruleCode        String   // "KYC_SINGLE_TX" | "DAILY_STRUCTURING" | "PEP_HIGH_VALUE" | "HIGH_RISK_MANUAL"
  name            String   // Kural adı
  thresholdAmount Float    // Eşik tutarı (örn: 185000 TL)
  timeWindowHours Int      @default(24) // Zaman penceresi (saat)
  riskLevel       String   @default("HIGH") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  isActive        Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dealerId, ruleCode])
}

model ComplianceCase {
  id                 String    @id @default(cuid())
  caseNumber         String    // Örn: "MASAK-2026-0001"
  dealerId           String
  dealer             Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerTcNo       String?
  customerPhone      String?
  riskLevel          String    @default("HIGH") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  status             String    @default("OPEN") // "OPEN" | "UNDER_REVIEW" | "REPORTED_TO_MASAK" | "DISMISSED"
  triggerType        String    // "KYC_THRESHOLD_EXCEEDED" | "SMURFING_DETECTED" | "PEP_TRANSACTION" | "MANUAL_SUSPICION"
  detectedAmount     Float     // Tetikleyen tutar TL
  description        String    // Olay özeti
  investigationNotes String?   // Uyum sorumlusunun inceleme notları
  sarDraft           String?   // MASAK ŞİB (Şüpheli İşlem Bildirimi) metin taslağı
  reportedToMasakAt  DateTime? // MASAK'a resmi bildirim yapılma tarihi
  reportedBy         String?   // Bildirimi yapan yetkili
  reviewedBy         String?   // İnceleyen uyum sorumlusu
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([dealerId, caseNumber])
  @@index([dealerId, status])
  @@index([dealerId, riskLevel])
}

// =============================================================
// FAZ 3B: Banka, POS & Açık Bankacılık Mutabakatı
// =============================================================

model BankAccount {
  id                String            @id @default(cuid())
  dealerId          String
  dealer            Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  bankName          String            // "Ziraat Bankası", "Garanti BBVA", "Kuveyt Türk", "İş Bankası"
  accountName       String            // "Ana Şube Vadesiz", "Altın Depo Hesabı"
  accountType       String            @default("VADESIZ_TL") // "VADESIZ_TL" | "VADESIZ_USD" | "VADESIZ_EUR" | "ALTIN_HESABI"
  currency          String            @default("TL") // "TL" | "USD" | "EUR" | "HAS"
  iban              String
  accountNumber     String?
  branchCode        String?
  balance           Float             @default(0) // TL tutarı veya gr Has
  integrationType   String            @default("MANUAL") // "MANUAL" | "OPEN_BANKING_API" | "STATEMENT_IMPORT"
  apiClientId       String?
  apiEncryptedToken String?
  lastSyncedAt      DateTime?
  isActive          Boolean           @default(true)
  posTerminals      PosTerminal[]
  transactions      BankTransaction[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([dealerId, iban])
}

model PosTerminal {
  id              String          @id @default(cuid())
  dealerId        String
  dealer          Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  bankAccountId   String
  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  name            String          // "Garanti Yazar Kasa POS", "Ziraat Mobil POS"
  terminalId      String          // TID (Terminal ID)
  merchantId      String?         // MID (Üye İşyeri No)
  commissionRate  Float           @default(1.90) // Tek çekim komisyon oranı (%)
  blockingDays    Int             @default(1)    // Valör / Bloke gün sayısı (1: ertesi gün, 30: 30 gün)
  isActive        Boolean         @default(true)
  settlements     PosSettlement[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([dealerId, terminalId])
}

model BankTransaction {
  id                   String       @id @default(cuid())
  dealerId             String
  dealer               Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  bankAccountId        String
  bankAccount          BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  externalTxId         String?      // Banka referans no
  amount               Float        // Tutar (TL/Döviz/gr Has)
  direction            String       // "INFLOW" (Giriş / Alacak) | "OUTFLOW" (Çıkış / Borç)
  type                 String       @default("HAVALE_EFT") // "HAVALE_EFT" | "POS_SETTLEMENT" | "EXPENSE_FEE" | "CASH_DEPOSIT" | "CASH_WITHDRAWAL"
  description          String
  senderReceiverName   String?
  senderReceiverIban   String?
  matchStatus          String       @default("UNMATCHED") // "UNMATCHED" | "MATCHED" | "SUGGESTED"
  matchedTransactionId String?      // KuyumPanel Transaction ID
  matchedAt            DateTime?
  transactionDate      DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([dealerId, matchStatus])
  @@index([dealerId, transactionDate])
}

model PosSettlement {
  id               String      @id @default(cuid())
  dealerId         String
  dealer           Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  posTerminalId    String
  posTerminal      PosTerminal @relation(fields: [posTerminalId], references: [id], onDelete: Cascade)
  settlementDate   DateTime    @default(now())
  maturityDate     DateTime    // Valör tarihi (Hesaba geçeceği gün)
  grossAmount      Float       // Brüt POS Çekimi TL
  commissionAmount Float       // Banka Komisyon Kesintisi TL
  netAmount        Float       // Net Hesaba Geçecek Tutar TL
  status           String      @default("BLOCKED") // "BLOCKED" (Blokede) | "SETTLED" (Hesaba Geçti) | "DISCREPANCY"
  settledAt        DateTime?
  referenceNo      String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([dealerId, status])
  @@index([dealerId, maturityDate])
}

// =============================================================
// FAZ 41: Geçmiş Kurlar ve Milyem Geçmişi Modelleri
// =============================================================

model PriceSnapshot {
  id             String              @id @default(cuid())
  dealerId       String
  dealer         Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  capturedAt     DateTime            @default(now())
  captureSlotKey String              // "2026-09-09-17-00" (Europe/Istanbul 30 dk slot)
  source         String              @default("ALTIS") // "ALTIS" | "HAREM" | "MANUAL" | "SYSTEM"
  status         String              @default("SUCCESS") // "SUCCESS" | "FAILED" | "PARTIAL"
  errorMessage   String?
  items          PriceSnapshotItem[]
  createdAt      DateTime            @default(now())

  @@unique([dealerId, captureSlotKey])
  @@index([dealerId, capturedAt])
}

model PriceSnapshotItem {
  id                String        @id @default(cuid())
  snapshotId        String
  snapshot          PriceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productCode       String        // Örn: "HAS_ALTIN", "USD", "EUR", "CEYREK_YENI"
  label             String        // Örn: "Has Altın (Gr)", "Amerikan Doları"
  bid               Float         // Alış Fiyatı (TL)
  ask               Float         // Satış Fiyatı (TL)
  currency          String        @default("TL")
  source            String?
  providerUpdatedAt DateTime?
  createdAt         DateTime      @default(now())

  @@index([snapshotId, productCode])
}

model MilyemSnapshot {
  id             String               @id @default(cuid())
  dealerId       String
  dealer         Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  capturedAt     DateTime             @default(now())
  captureSlotKey String               // "2026-09-09-17-00"
  source         String               @default("SYSTEM") // "SYSTEM" | "MANUAL"
  items          MilyemSnapshotItem[]
  createdAt      DateTime             @default(now())

  @@unique([dealerId, captureSlotKey])
  @@index([dealerId, capturedAt])
}

model MilyemSnapshotItem {
  id         String         @id @default(cuid())
  snapshotId String
  snapshot   MilyemSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  code       String         // "mil24Ayar", "mil22Ayar", "mil14Ayar", "milAdanaBurma", "milAjda"
  label      String         // "24 Ayar (Has)", "22 Ayar Bilezik", vb.
  value      Float          // 995, 916, 585, vb.
  unit       String         @default("milyem")
  createdAt  DateTime       @default(now())

  @@index([snapshotId, code])
}

// =============================================================
// FAZ 42: Toptancı Siparişi Mesajlaşma Modeli
// =============================================================

model PurchaseOrderMessage {
  id                  String        @id @default(cuid())
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  provider            String        @default("WEB_INTENT") // "WEB_INTENT" | "CLOUD_API" | "GATEWAY"
  recipientPhone      String
  messageBodySnapshot String        // Gönderilen metnin o anki kopyası
  status              String        @default("SENT") // "SENT" | "FAILED" | "QUEUED"
  externalMessageId   String?
  sentAt              DateTime      @default(now())
  deliveredAt         DateTime?
  errorCode           String?
  safeErrorMessage    String?

  @@index([purchaseOrderId])
}

// =============================================================
// FAZ 43: İşletme IBAN Kayıt Yönetimi Modeli
// =============================================================

model BusinessBankAccount {
  id                 String   @id @default(cuid())
  dealerId           String
  dealer             Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bankName           String   // Örn: "Ziraat Bankası", "Garanti BBVA", "İş Bankası"
  accountHolderName  String   // Hesap sahibi / Unvan
  currency           String   @default("TRY") // "TRY" | "USD" | "EUR" | "XAU"
  encryptedIban      String   // AES-256-GCM ile şifreli tam IBAN
  ibanFingerprint    String   // HMAC/SHA256 tekillik özeti
  maskedIban         String   // "TR** **** **** **12 34"
  isActive           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  note               String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([dealerId, ibanFingerprint])
  @@index([dealerId, isActive])
}

// =============================================================
// FAZ 44: Müşteri Kimlik Havuzu Modeli (TCKN Vault)
// =============================================================

model CustomerIdentity {
  id                           String    @id @default(cuid())
  dealerId                     String
  dealer                       Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customerId                   String?
  customer                     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName                    String
  lastName                     String
  encryptedTcNo                String    // AES-256-GCM şifreli TCKN
  tcNoFingerprint              String    // HMAC tekillik özeti
  maskedTcNo                   String    // "123*****89"
  purpose                      String    // "FATURA_DUZENLEME" | "MASAK_AML" | "YUKSEK_TUTARLI_ISLEM" | "EMANET_TESLIM" | "GENEL"
  legalBasisOrConsentReference String?   // Dayanak belge / Rıza metni referansı
  collectedAt                  DateTime  @default(now())
  retentionUntil               DateTime  // Saklama son tarihi (örn: +10 yıl)
  status                       String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "DESTROYED"
  createdBy                    String?
  updatedBy                    String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([dealerId, tcNoFingerprint])
  @@index([dealerId, status])
  @@index([dealerId, customerId])
}

// =============================================================
// FAZ 45: Kuyumcu Defteri & Operasyonel Notlar Modeli
// =============================================================

model JewelerNotebookEntry {
  id                   String        @id @default(cuid())
  dealerId             String
  dealer               Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category             String        @default("GENERAL") // "GENERAL" | "CUSTOMER" | "SUPPLIER" | "WORKSHOP" | "SERVICE" | "PRICE" | "REMINDER" | "PRIVATE"
  title                String
  content              String        // Markdown / Düz metin (HTML sanitize)
  visibility           String        @default("DEALER") // "PRIVATE" | "BRANCH" | "DEALER"
  linkedCustomerId     String?
  linkedCustomer       Customer?     @relation(fields: [linkedCustomerId], references: [id], onDelete: SetNull)
  linkedSupplierId     String?
  linkedSupplier       Supplier?     @relation(fields: [linkedSupplierId], references: [id], onDelete: SetNull)
  linkedWorkshopJobId  String?
  linkedWorkshopJob    WorkshopJob?  @relation(fields: [linkedWorkshopJobId], references: [id], onDelete: SetNull)
  linkedServiceOrderId String?
  linkedServiceOrder   ServiceOrder? @relation(fields: [linkedServiceOrderId], references: [id], onDelete: SetNull)
  reminderAt           DateTime?     // Hatırlatma zamanı
  isPinned             Boolean       @default(false)
  status               String        @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  createdBy            String        // Oluşturan kullanıcı ID / email
  updatedBy            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([dealerId, category])
  @@index([dealerId, visibility])
  @@index([dealerId, isPinned])
  @@index([dealerId, reminderAt])
}

// =============================================================
// FAZ 46: Servis & Tamirat Fotoğrafları Modeli
// =============================================================

model ServiceOrderPhoto {
  id               String       @id @default(cuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  storageReference String       // Güvenli yerel dosya yolu veya veri referansı
  fileName         String
  mimeType         String       // "image/jpeg" | "image/png" | "image/webp"
  fileSize         Int          // Bayt cinsinden boyut
  photoType        String       @default("INTAKE") // "INTAKE" | "IN_PROGRESS" | "COMPLETED" | "DEFECT"
  uploadedBy       String?
  createdAt        DateTime     @default(now())

  @@index([serviceOrderId])
}



